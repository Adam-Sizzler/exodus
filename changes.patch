+			if override.Port != nil {
+				h.Port = *override.Port
+			}
+			if override.Remark != nil {
+				h.Remark = *override.Remark
+			}
+			if override.SNI != nil {
+				h.SNI = override.SNI
+			}
+			if override.Host != nil {
+				h.Host = override.Host
+			}
+			if override.Path != nil {
+				h.Path = override.Path
+			}
+		}
+	}
+	return hosts
+}
