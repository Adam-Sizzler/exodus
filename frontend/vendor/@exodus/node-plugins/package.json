{
  "name": "@exodus/node-plugins",
  "version": "0.4.5",
  "public": true,
  "license": "AGPL-3.0-only",
  "description": "A library for Exodus Node Plugins.",
  "author": "EXODUS <github.com/exodus>",
  "homepage": "https://github.com/exodus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exodus/backend.git"
  },
  "bugs": {
    "url": "https://github.com/exodus/backend/issues"
  },
  "main": "build/backend/index.js",
  "browser": "build/frontend/index.js",
  "types": "build/backend/index.d.ts",
  "files": [
    "build/**/*"
  ],
  "scripts": {
    "clean": "rm -rf build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "tsc -p tsconfig.frontend.json",
    "build": "npm run clean && npm run build:backend && npm run build:frontend",
    "prepublish": "npm run build"
  },
  "keywords": [],
  "dependencies": {
    "zod": "3.25.76"
  }
}