# Multistage build for v2rs node
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata gcc musl-dev

ARG VERSION=docker

WORKDIR /build

# Copy go mod files and download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build node binary
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X v2ray-stat/constant.Version=${VERSION}" \
    -o v2rs-node \
    ./node

# Final stage
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN addgroup -g 1000 v2ray && \
    adduser -D -u 1000 -G v2ray v2ray

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/v2rs-node /app/

# Create directories for certificates and xray/singbox configs
RUN mkdir -p /app/certs /app/xray /app/logs && \
    chown -R v2ray:v2ray /app

# Copy default config
COPY node/config.yml /app/config.yml.example

USER v2ray

ENTRYPOINT ["/app/v2rs-node"]
