############################################
# v2ray-stat panel
############################################

### App ports
APP_PORT=9242
APP_BASE_PATH=/panel
BACKEND_PORT=9243
BACKEND_ADDRESS=0.0.0.0

### Logging/timezone
TZ=UTC
LOG_LEVEL=debug
LOG_MODE=inclusive

### Panel behavior
V2RS_ALLOW_INSECURE_HTTP=true
V2RS_TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12,10.0.0.0/8
FRONT_END_DOMAIN=localhost
SUB_PUBLIC_DOMAIN=sub.localhost

### Infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:postgres@v2rs-db:5432/postgres
REDIS_HOST=v2rs-redis
REDIS_PORT=6379

### JWT (required)
JWT_AUTH_SECRET=change_me_64bytes
JWT_API_TOKENS_SECRET=change_me_64bytes
