# Multistage build for v2rs subscription
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata gcc musl-dev sqlite-dev

ARG VERSION=docker

WORKDIR /build

# Copy go mod files and download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build subscription binary
RUN CGO_ENABLED=1 GOOS=linux go build \
    -ldflags="-s -w -X v2ray-stat/constant.Version=${VERSION}" \
    -o v2rs-subscription \
    ./subscription

# Final stage
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN addgroup -g 1000 v2ray && \
    adduser -D -u 1000 -G v2ray v2ray

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/v2rs-subscription /app/

# Copy subscription templates
COPY --chown=v2ray:v2ray subscription/templates /app/templates

# Create certificates directory
RUN mkdir -p /app/certs && \
    chown -R v2ray:v2ray /app

# Copy default config
COPY subscription/config.yml /app/config.yml.example

USER v2ray

ENTRYPOINT ["/app/v2rs-subscription"]
