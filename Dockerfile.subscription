# Multistage build for v2rs subscription (backend + optional frontend)
FROM node:20-alpine AS subscription-ui
WORKDIR /ui
COPY front/subscription/ ./
RUN if [ -f package.json ]; then \
      if [ -f package-lock.json ]; then npm ci; else npm install; fi; \
      npm run build; \
    else mkdir -p dist; fi

FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata gcc musl-dev sqlite-dev

ARG VERSION=unknown
ARG REVISION=unknown
ARG BUILD_TAGS=none
ARG CGO_ENABLED_STATUS=enabled

WORKDIR /build

# Copy go mod files and download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build subscription binary
RUN CGO_ENABLED=1 \
    GOOS=linux \
    go build \
        -tags "${BUILD_TAGS}" \
        -trimpath \
        -buildvcs=true \
        -ldflags="-s -w \
                -X v2ray-stat/constant.Version=${VERSION} \
                -X v2ray-stat/constant.Revision=${REVISION} \
                -X v2ray-stat/constant.BuildTags=${BUILD_TAGS} \
                -X v2ray-stat/constant.CgoEnabled=${CGO_ENABLED_STATUS}" \
    -o v2rs-subscription \
    ./backend/subscription

# Final stage
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN addgroup -g 1000 v2ray && \
    adduser -D -u 1000 -G v2ray v2ray

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/v2rs-subscription /app/

# Copy subscription templates
COPY --chown=v2ray:v2ray backend/subscription/templates /app/templates

# Copy subscription assets
COPY --chown=v2ray:v2ray backend/subscription/assets /app/assets

# Copy built frontend (if any)
COPY --from=subscription-ui /ui/dist /app/ui

# Create certificates directory
RUN mkdir -p /app/certs && \
    chown -R v2ray:v2ray /app

# Copy default config
COPY backend/subscription/config.yml /app/config.yml.example

USER v2ray

ENTRYPOINT ["/app/v2rs-subscription"]
