{
  "log": {
    "level": "info",
    "timestamp": true,
    "output": "/app/logs/access.log"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 10010
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct"
  },
  "experimental": {
    "v2ray_api": {
      "listen": "127.0.0.1:10085",
      "stats": {
        "enabled": true,
        "inbounds": [
          "mixed-in"
        ],
        "outbounds": [
          "direct"
        ],
        "users": []
      }
    }
  }
}
