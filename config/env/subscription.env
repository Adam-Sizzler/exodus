APP_PORT_SUB=3010
NODE_ENV=development
SUB_GRPC_ADDRESS=0.0.0.0
SUB_GRPC_PORT=2222
# Accepted forms are equivalent: "/subscription", "/subscription/".
# Root is equivalent in both forms: empty value and "/".
SUB_GRPC_PATH=/
SUB_GRPC_TOKEN=
# If SUB_SECRET_KEY is set -> mTLS mode (token optional).
# If SUB_SECRET_KEY is empty -> TLS+token mode (token required).
SUB_SECRET_KEY=

# Optional security bypass headers for protected panel setups
CADDY_AUTH_API_TOKEN=
CLOUDFLARE_ZERO_TRUST_CLIENT_ID=
CLOUDFLARE_ZERO_TRUST_CLIENT_SECRET=
