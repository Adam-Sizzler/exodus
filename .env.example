############################################
# exodus subscription page environment template
############################################

### APP ###
APP_PORT_SUB=3010
SUB_GRPC_ADDRESS=0.0.0.0
SUB_GRPC_PORT=2222
# Optional gRPC path prefix.
# Accepted forms are equivalent: "/subscription", "/subscription/".
# Root is equivalent in both forms: empty value and "/".
SUB_GRPC_PATH=
# Local directory where downloaded SRS files are stored and served from /<SUB_GRPC_PATH>/ruleset/.
SUB_SRS_DIR=/opt/app/ruleset
# Dashboard → Subscription → Nodes → Current node → gRPC Token (SUB_GRPC_TOKEN).
# Required when SUB_SECRET_KEY is empty.
SUB_GRPC_TOKEN=
# Dashboard → Subscription → Nodes → Current node → Secret Key (SUB_SECRET_KEY).
# Optional mTLS payload. If set, gRPC auth mode is mTLS and SUB_GRPC_TOKEN is optional.
# If not set, gRPC auth mode is TLS+token and SUB_GRPC_TOKEN is required.
SUB_SECRET_KEY=

CLOUDFLARE_ZERO_TRUST_CLIENT_ID=
CLOUDFLARE_ZERO_TRUST_CLIENT_SECRET=

### LOGGING ###
# production = normal logs, development = debug/access logs like exodus.
NODE_ENV=production
# Keep false in production. Set true only when you need exodus-like debug/access logs.
ENABLE_DEBUG_LOGS=false
# Optional: console or json. JSON is better for Docker/Loki/ELK.
LOG_FORMAT=console