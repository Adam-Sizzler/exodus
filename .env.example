############################################
# exodus node environment template
############################################

### LOGGING ###
# Log level: trace, debug, info, warn, error, none (default: info)
LOG_LEVEL=info

### NODE gRPC ###
# Bind address and port for incoming panel gRPC connections (default: 0.0.0.0:2222)
NODE_GRPC_ADDRESS=0.0.0.0
NODE_GRPC_PORT=2222

# Optional gRPC path prefix when running behind reverse proxy (e.g. /node or empty for root)
NODE_GRPC_PATH=

# Dashboard → Nodes → Current node → gRPC Token (NODE_GRPC_TOKEN).
# Required when SECRET_KEY is empty (TLS + token reverse proxy mode).
NODE_GRPC_TOKEN=

# Dashboard → Nodes → Current node → Secret Key (SECRET_KEY).
# Base64-encoded mTLS secret containing caCertPem, nodeCertPem, nodeKeyPem, and jwtPublicKey.
# If set, mTLS is enabled and NODE_GRPC_TOKEN is optional.
SECRET_KEY=

### SECURITY & TLS ###
# Enable strict SNI verification for incoming mTLS connections (default: false)
SNI_VERIFICATION=false

### NFTABLES / FIREWALL ###
# Enable kernel logging for dropped packets in Ingress/Egress filters (default: true)
NFTABLES_LOGGING=true

# Allow return/reply traffic for outgoing connections to ingress-blocked IPs (default: false)
NFTABLES_ACCEPT_REPLY_TRAFFIC=false
