# V2Ray-Stat Docker Environment Configuration
# Скопируйте этот файл в .env и настройте под ваши нужды
# cp .env.example .env

# ===== Общие настройки =====

# Часовой пояс (IANA timezone)
TZ=Asia/Bangkok

# Версия приложения (используется при сборке)
VERSION=latest

# ===== Backend настройки =====

# Порт Backend API
BACKEND_PORT=9243

# Адрес для прослушивания (0.0.0.0 - все интерфейсы, 127.0.0.1 - только localhost)
BACKEND_ADDRESS=0.0.0.0

# API Token (оставьте пустым для доступа без авторизации)
API_TOKEN=

# ===== Node настройки =====

# Порт Node gRPC
NODE_PORT=9253

# Адрес для прослушивания
NODE_ADDRESS=0.0.0.0

# ===== Subscription настройки =====

# HTTP порт
SUBSCRIPTION_HTTP_PORT=9264

# gRPC порт
SUBSCRIPTION_GRPC_PORT=9263

# Адрес для прослушивания
SUBSCRIPTION_ADDRESS=0.0.0.0

# ===== Пути к файлам =====

# Путь к главному конфигурационному файлу
CONFIG_PATH=./config.yaml

# Путь к директории с сертификатами
CERTS_PATH=./certs

# Путь к директории с данными
DATA_PATH=./data

# Путь к директории с логами
LOGS_PATH=./logs

# Путь к конфигурации Xray/Singbox (для Node)
XRAY_CONFIG_PATH=/usr/local/etc/xray

# ===== База данных =====

# Путь к SQLite базе данных внутри контейнера
DATABASE_PATH=/app/data/data.db

# ===== Логирование =====

# Уровень логирования: none, error, warn, info, debug, trace
LOG_LEVEL=info

# Режим логирования: inclusive (включает нижние уровни), exclusive (только указанный уровень)
LOG_MODE=inclusive

# Максимальный размер лог файла (для Docker logging driver)
LOG_MAX_SIZE=10m

# Количество ротируемых лог файлов
LOG_MAX_FILE=3

# ===== Network =====

# Подсеть Docker сети
DOCKER_SUBNET=172.20.0.0/16

# ===== Resource Limits (раскомментируйте для ограничения ресурсов) =====

# CPU limit (например, 0.5, 1, 2)
# CPU_LIMIT=1

# Memory limit (например, 256M, 512M, 1G)
# MEMORY_LIMIT=512M

# CPU reservation
# CPU_RESERVATION=0.25

# Memory reservation
# MEMORY_RESERVATION=128M

# ===== Дополнительные настройки =====

# Режим перезапуска контейнеров: no, always, on-failure, unless-stopped
RESTART_POLICY=unless-stopped

# Интервал health check (секунды)
HEALTHCHECK_INTERVAL=30s

# Таймаут health check (секунды)
HEALTHCHECK_TIMEOUT=5s

# Количество попыток health check перед пометкой как unhealthy
HEALTHCHECK_RETRIES=3
